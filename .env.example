# Copy this file to .env and fill in the values.
# On Agentverse: paste the same keys into the agent Secrets tab.

# ASI:One  — get a key at https://asi1.ai/developer
# Hosted Agentverse agents already inject these. Keep them for local runs.
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai/v1

# High-quality LinkedIn images (required on publish by default)
IMAGE_SIZE=1024x1024
IMAGE_OUTPUT_SIZE=1200
IMAGE_RETRIES=3
REQUIRE_IMAGE_ON_PUBLISH=1

# LinkedIn  — run python linkedin_setup.py to generate these
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN_EXPIRES_AT=0

# LinkedIn API version
LINKEDIN_VERSION=202608

# Daily approval draft schedule
POST_HOUR=18
POST_MINUTE=0
TIMEZONE=Asia/Kolkata

# Agent identity — replace the seed with your own unique private value.
# The agent refuses to start with a placeholder seed unless you set:
# ALLOW_INSECURE_SEED=1
AGENT_NAME=LinkedIn Buddy
AGENT_HANDLE=linkedin-buddy
AGENT_SEED=replace-with-a-unique-private-seed
AGENT_PORT=8001
ALLOW_INSECURE_SEED=0

# LinkedIn organization mentions (used only when the name appears in the draft)
FETCH_AI_URN=urn:li:organization:27233415
FETCH_AI_LAB_URN=urn:li:organization:103686899

# Person mentions are opt-in. Leave empty unless you have consent to mention
# this person from your LinkedIn account. Example:
# SANA_WAJID_URN=urn:li:person:244729573
SANA_WAJID_URN=

# Used only by linkedin_setup.py
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
